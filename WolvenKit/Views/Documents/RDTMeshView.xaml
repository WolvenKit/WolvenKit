                                    Margin="20,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding SlotName, StringFormat='slot: {0}'}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl-->
        </Grid>
    </Grid>
</reactiveUi:ReactiveUserControl>
