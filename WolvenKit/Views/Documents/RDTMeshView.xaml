<reactiveUi:ReactiveUserControl
    x:Class="WolvenKit.Views.Documents.RDTMeshView"
    x:TypeArguments="documents:RDTMeshViewModel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:documents="clr-namespace:WolvenKit.App.ViewModels.Documents;assembly=WolvenKit.App"
    xmlns:editors="clr-namespace:WolvenKit.Views.Editors"
    xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveUi="http://reactiveui.net"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:others="clr-namespace:WolvenKit.Views.Others"
    xmlns:templates="clr-namespace:WolvenKit.Views.Templates"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type={x:Type documents:RDTMeshViewModel}}"
    d:DesignWidth="800"
    d:DesignHeight="450"
    BorderBrush="{DynamicResource BorderAlt}"
    BorderThickness="1">
    <Grid>
        <Grid.Resources>
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{DynamicResource ContentBackground}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>

            <DataTemplate x:Key="WorldNodeIndexToolTipTemplate">
                <Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        Text="WorldNodeIndex" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="WorldNodeDataIndicesToolTipTemplate">
                <Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        Text="WorldNodeDataIndices" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="HeaderIconTemplate_WorldNodeIdx">
                <templates:IconBox
                    IconPack="Material"
                    Kind="Web"
                    Margin="0"
                    Size="{DynamicResource WolvenKitIconMicro}" />
            </DataTemplate>

            <DataTemplate x:Key="HeaderIconTemplate_WorldNodeDataIdx">
                <templates:IconBox
                    IconPack="Material"
                    Kind="ResistorNodes"
                    Margin="0"
                    Size="{DynamicResource WolvenKitIconMicro}" />
            </DataTemplate>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="{DynamicResource WolvenKitColumnTiny}" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Orientation="Vertical">
            <Expander
                Style="{StaticResource BaseStyle}"
                Visibility="Collapsed"
                Header="Assimp info"
                IsExpanded="False">
                <TextBlock
                    Name="FileFormatsTextBlock"
                    Margin="10,5,10,0"
                    Text=""
                    TextWrapping="Wrap" />
            </Expander>
        </StackPanel>

        <hx:Viewport3DX
            Name="hxViewport"
            Grid.Row="0"
            Grid.Column="0"
            IsEnabled="{Binding IsLoaded}"
            BackgroundColor="{DynamicResource WolvenKitViewportBackgroundColor}"
            Camera="{Binding Camera}"
            CoordinateSystemLabelForeground="{DynamicResource PrimaryTextColor}"
            EffectsManager="{Binding EffectsManager}"
            EnableRenderFrustum="True"
            EnableRenderOrder="True"
            FXAALevel="High"
            ShowCoordinateSystem="True"
            ViewCubeTexture="{Binding ViewCubeTexture}"
            UseDefaultGestures="False"
            Loaded="Viewport3DX_Loaded"
            CameraChanged="HxViewport_OnCameraChanged"
            ZoomExtentsWhenLoaded="True"
            
            OITRenderMode="DepthPeeling"
            OITDepthPeelingIteration="8">

            <hx:Viewport3DX.InputBindings>
                <MouseBinding
                    Command="hx:ViewportCommands.Rotate"
                    Gesture="LeftClick" />
                <MouseBinding
                    Command="hx:ViewportCommands.Pan"
                    Gesture="MiddleClick" />
                <MouseBinding
                    Command="hx:ViewportCommands.Rotate"
                    Gesture="Shift+MiddleClick" />
            </hx:Viewport3DX.InputBindings>

            <hx:DirectionalLight3D
                IsRendering="{Binding UseWorkLighting}"
                Direction="0, -1, 0"
                Color="White" />
            <hx:DirectionalLight3D
                IsRendering="{Binding UseWorkLighting}"
                Direction="0, 0, 1"
                Color="White" />
            <hx:DirectionalLight3D
                IsRendering="{Binding UseWorkLighting}"
                Direction="0, 0, -1"
                Color="White" />
            <hx:DirectionalLight3D
                IsRendering="{Binding UseWorkLighting}"
                Direction="1, 0, 0"
                Color="White" />
            <hx:DirectionalLight3D
                IsRendering="{Binding UseWorkLighting}"
                Direction="-1, 0, 0"
                Color="White" />

            <!-- Lighting presets (Camera section). Icon (soft): soft key from the viewer's upper left when looking at the
                 front (-Z), weaker fill from the right, rim from behind, a little from above and ambient -->
            <hx:AmbientLight3D IsRendering="{Binding UseIconLighting}" Color="#383838" />
            <hx:DirectionalLight3D IsRendering="{Binding UseIconLighting}" Direction="-0.5, -0.6, 1" Color="#E0E0E0" />
            <hx:DirectionalLight3D IsRendering="{Binding UseIconLighting}" Direction="1, -0.2, 0.6" Color="#6A6A6A" />
            <hx:DirectionalLight3D IsRendering="{Binding UseIconLighting}" Direction="0, -0.5, -1" Color="#8A8A8A" />
            <hx:DirectionalLight3D IsRendering="{Binding UseIconLighting}" Direction="0, -1, 0" Color="#505050" />
            <!-- Icon (follow camera): same set, directions set from the camera in code-behind -->
            <hx:AmbientLight3D IsRendering="{Binding UseFollowLighting}" Color="#383838" />
            <hx:DirectionalLight3D Tag="FollowKey" IsRendering="{Binding UseFollowLighting}" Direction="-0.5, -0.6, 1" Color="#E0E0E0" />
            <hx:DirectionalLight3D Tag="FollowFill" IsRendering="{Binding UseFollowLighting}" Direction="1, -0.2, 0.6" Color="#6A6A6A" />
            <hx:DirectionalLight3D Tag="FollowRim" IsRendering="{Binding UseFollowLighting}" Direction="0, -0.5, -1" Color="#8A8A8A" />
            <hx:DirectionalLight3D Tag="FollowTop" IsRendering="{Binding UseFollowLighting}" Direction="0, -1, 0" Color="#505050" />
            <!-- Flat: ambient only -->
            <hx:AmbientLight3D IsRendering="{Binding UseFlatLighting}" Color="#707070" />

            <!-- hx:ShadowMap3D / -->
            <hx:DynamicReflectionMap3D x:Name="hxReflection" IsDynamicScene="True">
                <!-- hx:EnvironmentMap3D Texture="{Binding EnvironmentMap}" / -->
                <hx:ItemsModel3D x:Name="hxContentVisual" />
            </hx:DynamicReflectionMap3D>

            <!-- hx:Element3DPresenter Content="{Binding GroupModel}" / -->
            <hx:Viewport3DX.ContextMenu>
                <ContextMenu>
                    <MenuItem
                        Click="ReloadModels"
                        Header="Zoom to extents">
                        <MenuItem.Icon>
                            <templates:IconBox
                                IconPack="Material"
                                Kind="MagnifyExpand"
                                Foreground="{DynamicResource ContentForeground}" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </hx:Viewport3DX.ContextMenu>
        </hx:Viewport3DX>

        <!-- Cover while saving images: hides the resizing and appearance switching; the capture
             reads the render buffer, so the cover is not in the images -->
        <Border
            Grid.Row="0"
            Grid.Column="0"
            Background="{DynamicResource ContentBackground}"
            Visibility="{Binding IsSavingImage, Converter={StaticResource VisibilityConverter}}">
            <StackPanel
                MinWidth="260"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <TextBlock
                    Margin="0,0,0,8"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource ContentForeground}"
                    FontSize="14"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Text="{Binding SavingImageStatus}" />
                <ProgressBar
                    Height="6"
                    Minimum="0"
                    Maximum="{Binding SavingImageTotal}"
                    Value="{Binding SavingImageDone}" />
                <Button
                    Margin="0,10,0,0"
                    Padding="12,2"
                    HorizontalAlignment="Center"
                    Visibility="{Binding IsSavingImageBatch, Converter={StaticResource VisibilityConverter}}"
                    Click="CancelSavingImages_OnClick"
                    Content="Cancel" />
            </StackPanel>
        </Border>

        <others:LoadingTextControl
            Grid.Row="0"
            Grid.Column="0"
            VisibilityFlag="{Binding IsLoaded}"
            Small="True" />

        <syncfusion:SfGridSplitter
            Grid.Row="0"
            Grid.Column="1"
            HorizontalAlignment="Stretch" />

        <Grid
            Grid.Row="0"
            Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Width="Auto"
                IsEnabled="{Binding IsLoaded}"
                Grid.IsSharedSizeScope="True"
                Orientation="Vertical">
                <!-- Appearance -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="ColumnHeader" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        BorderBrush="{DynamicResource BorderAlt}"
                        BorderThickness="0,0,1,1" />

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="{DynamicResource WolvenKitMarginTinyHorizontal}"
                        Padding="{DynamicResource WolvenKitMarginTinyVertical}"
                        VerticalAlignment="Center"
                        Text="Appearance: " />

                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        BorderBrush="{DynamicResource BorderAlt}"
                        BorderThickness="0,0,0,1" />

                    <ComboBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Padding="{DynamicResource WolvenKitMarginTinyHorizontal}"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding Appearances,
                                              Mode=OneWay}"
                        SelectedItem="{Binding SelectedAppearance,
                                               Mode=TwoWay,
                                               UpdateSourceTrigger=PropertyChanged}" />

                    <Border
                        Grid.Row="0"
                        Grid.Column="2"
                        BorderBrush="{DynamicResource BorderAlt}"
                        BorderThickness="0,0,0,1" />

                    <Button
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="{DynamicResource WolvenKitMarginTinyHorizontal}"
                        Padding="{DynamicResource WolvenKitMarginTiny}"
                        IsEnabled="{Binding IsAppearanceSelected}"
                        Command="{Binding CopyAppearanceNameCommand}"
                        ToolTip="Copy appearance name">
                        <templates:IconBox
                            IconPack="Material"
                            Kind="ContentCopy"
                            Margin="0"
                            Size="{DynamicResource WolvenKitIconMicro}"
                            Foreground="{DynamicResource ContentForeground}" />
                    </Button>
                </Grid>

                <!-- Level of Detail -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="ColumnHeader" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        BorderBrush="{DynamicResource BorderAlt}"
                        BorderThickness="0,0,1,1" />

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="{DynamicResource WolvenKitMarginTinyHorizontal}"
                        Padding="{DynamicResource WolvenKitMarginTinyVertical}"
                        VerticalAlignment="Center"
                        Text="Level of Detail: " />

                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        BorderBrush="{DynamicResource BorderAlt}"
                        BorderThickness="0,0,0,1" />

                    <ComboBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Padding="{DynamicResource WolvenKitMarginSmallHorizontal}"
                        ItemsSource="{Binding SelectedAppearance.LODLUT.Keys,
                                              Mode=OneWay}"
                        SelectedItem="{Binding SelectedAppearance.SelectedLOD,
                                               Mode=TwoWay,
                                               UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- Selection -->
                <Grid Visibility="{Binding PanelVisibility.ShowSelectionPanel, Converter={StaticResource VisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="ColumnHeader" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        BorderBrush="{DynamicResource BorderAlt}"
                        BorderThickness="0,0,1,1" />

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="{DynamicResource WolvenKitMarginTinyHorizontal}"
                        Padding="{DynamicResource WolvenKitMarginTinyVertical}"
                        VerticalAlignment="Center"
                        Text="Selection: " />

                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        BorderBrush="{DynamicResource BorderAlt}"
                        BorderThickness="0,0,0,1" />

                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="{DynamicResource WolvenKitMarginTinyLeft}"
                        VerticalAlignment="Center"
                        Visibility="{Binding CurrentSelection.IsValid,
                                             Converter={StaticResource VisibilityConverter}}"
                        Orientation="Horizontal">
                        <templates:IconBox
                            IconPack="Codicons"
                            Kind="SymbolClass"
                            Margin="0"
                            Size="{DynamicResource WolvenKitIconMicro}"
                            Foreground="{DynamicResource ContentForeground}" />

                        <TextBlock
                            Margin="{DynamicResource WolvenKitMarginTinyLeft}"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource WolvenKitTan}"
                            Text="worldNodeData" />

                        <TextBlock
                            Margin="{DynamicResource WolvenKitMarginTinyLeft}"
                            Text="{Binding CurrentSelection.WorldNodeIndex,
                                           Mode=OneWay,
                                           UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Margin="{DynamicResource WolvenKitMarginTinyLeft}"
                            Text="{Binding CurrentSelection.Name,
                                           Mode=OneWay,
                                           UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <!-- Sector / block previews: coordinate search, collisions, adding sectors -->
                <Expander
                    Margin="{DynamicResource WolvenKitMarginTiny}"
                    Header="Sector"
                    Visibility="{Binding PanelVisibility.ShowSearchPanel, Converter={StaticResource VisibilityConverter}}"
                    IsExpanded="{Binding IsSectorSectionExpanded}">
                    <StackPanel Orientation="Vertical">
                        <!-- Variants: which node ranges show, like the appearance of a mesh or an entity -->
                        <Grid Visibility="{Binding HasSectorVariants, Converter={StaticResource VisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Margin="{DynamicResource WolvenKitMarginTiny}"
                                VerticalAlignment="Center"
                                Text="Variant:" />
                            <ComboBox
                                Grid.Column="1"
                                Margin="{DynamicResource WolvenKitMarginTiny}"
                                Padding="{DynamicResource WolvenKitMarginTinyHorizontal}"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding SectorVariants,
                                                      Mode=OneWay}"
                                SelectedItem="{Binding SelectedSectorVariant,
                                                       Mode=TwoWay,
                                                       UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Sector variants are node sets a quest switches on and off (intact / destroyed, decorations...). Nodes that are always loaded always show." />
                        </Grid>

                        <!-- Proxy meshes: low detail stand-ins for content of other sectors -->
                        <CheckBox
                            Margin="{DynamicResource WolvenKitMarginTiny}"
                            IsChecked="{Binding ShowSectorProxies}"
                            Content="Show proxy meshes"
                            ToolTip="Proxy meshes are low detail stand-ins the game shows from far away instead of the real content. Off: hidden, so they don't cover the real meshes." />

                        <!-- Foliage: grass, bushes, trees; can be thousands of instances -->
                        <CheckBox
                            Margin="{DynamicResource WolvenKitMarginTiny}"
                            IsChecked="{Binding ShowSectorFoliage}"
                            Content="Show foliage"
                            ToolTip="Grass, bushes and trees (foliage nodes). Turn off to see the ground and the meshes under them, or when a sector with a lot of foliage is slow to move around." />

                        <!-- Area volumes (triggers, light channels, GI spaces...): quick switch for all of them -->
                        <CheckBox
                            Margin="{DynamicResource WolvenKitMarginTiny}"
                            IsChecked="{Binding ShowSectorAreas}"
                            Content="Show areas"
                            ToolTip="Area volumes: triggers, interiors, ambient (sound), light channel and GI areas, world boundaries... Off: all hidden; single areas can still be switched in the tree." />

                        <!-- Area volumes coloured by kind (trigger, light channel, GI space...) or all plain; shown with the areas -->
                        <CheckBox
                            Margin="{DynamicResource WolvenKitMarginTiny}"
                            Visibility="{Binding ShowSectorAreas, Converter={StaticResource VisibilityConverter}}"
                            IsChecked="{Binding ColorSectorAreas}"
                            Content="Color areas by type"
                            ToolTip="On: triggers orange, kill triggers red, world boundaries crimson, light channels purple, GI spaces teal, ambient (sound) areas blue, interiors light blue; other areas in the color the node carries. Off: all areas faint white. The Material column of an area's volume row names its kind." />

                        <!-- Search Coordinate -->
                        <StackPanel Orientation="Vertical">
                            <TextBlock
                                Margin="{DynamicResource WolvenKitMarginTiny}"
                                VerticalAlignment="Center"
                                Text="Search Coordinate:" />

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="{DynamicResource WolvenKitColumnTiny}" />
                                    <RowDefinition />
                                    <RowDefinition Height="{DynamicResource WolvenKitColumnTiny}" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="TextBlock" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="{DynamicResource WolvenKitMarginTinyHorizontal}"
                                    VerticalAlignment="Center"
                                    Text="X: " />
                                <editors:RedFloatEditor
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="{DynamicResource WolvenKitMarginTinyRight}"
                                    RedNumber="{Binding SearchPoint.X,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="{DynamicResource WolvenKitMarginTinyHorizontal}"
                                    VerticalAlignment="Center"
                                    Text="Y: " />
                                <editors:RedFloatEditor
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="{DynamicResource WolvenKitMarginTinyRight}"
                                    RedNumber="{Binding SearchPoint.Y,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Margin="{DynamicResource WolvenKitMarginTinyHorizontal}"
                                    VerticalAlignment="Center"
                                    Text="Z: " />

                                <editors:RedFloatEditor
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Margin="{DynamicResource WolvenKitMarginTinyRight}"
                                    RedNumber="{Binding SearchPoint.Z,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Margin="{DynamicResource WolvenKitMarginTinyTop}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    BorderBrush="{DynamicResource BorderAlt}"
                                    BorderThickness="0,0,0,1" />

                                <Button
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="{DynamicResource WolvenKitMarginTiny}"
                                    Padding="{DynamicResource WolvenKitMarginTiny}"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding SearchForPointCommand}"
                                    Content="Search for Coordinate" />

                                <Button
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="{DynamicResource WolvenKitMarginTiny}"
                                    Padding="{DynamicResource WolvenKitMarginTiny}"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding ClearSearchCommand}"
                                    Content="Clear Search" />
                            </Grid>
                        </StackPanel>

                        <!-- Collisions/Sectors -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <Button
                                x:Name="ToggleCollisionButton"
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="{DynamicResource WolvenKitMarginTiny}"
                                Padding="{DynamicResource WolvenKitMarginTiny}"
                                Visibility="{Binding PanelVisibility.ShowToggleCollision,
                                                     Converter={StaticResource VisibilityConverter}}"
                                Command="{Binding ToggleCollisionCommand}"
                                Content="Toggle Collision"
                                ToolTip="Toggles the collision nodes" />

                            <Button
                                x:Name="AddSectorsButton"
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="{DynamicResource WolvenKitMarginTiny}"
                                Padding="{DynamicResource WolvenKitMarginTiny}"
                                Visibility="{Binding PanelVisibility.ShowAddSectors,
                                                     Converter={StaticResource VisibilityConverter}}"
                                Command="{Binding AddSectorsToProjectCommand}"
                                Content="Add Sectors to Project"
                                ToolTip="Adds the selected sectors to the project" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Sections; their expanded state is kept for the session (see RDTMeshViewModel.PreviewImage.cs) -->
                <Expander
                    Margin="{DynamicResource WolvenKitMarginTiny}"
                    Header="Materials"
                    IsExpanded="{Binding IsMaterialsSectionExpanded}">
                    <StackPanel Orientation="Vertical">
                        <!-- Load/Generate Materials -->
                        <Grid>
                            <!--
                                Generate Materials: click = generate, Ctrl + click = clear cache and regenerate
                                (the label says so while Ctrl is held). The arrow opens the same choices as a
                                menu: click it, or press and drag onto an entry and release.
                            -->
                            <Grid Grid.Row="0" Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    Grid.Column="0"
                                    Margin="{DynamicResource WolvenKitMarginTiny}"
                                    Padding="{DynamicResource WolvenKitMarginTiny}"
                                    Foreground="{DynamicResource WolvenKitYellow}"
                                    IsEnabled="{Binding IsLoadingMaterials,
                                                        Converter={StaticResource InvertBooleanConverter}}"
                                    Command="{Binding LoadMaterialsCommand}"
                                    ToolTip="Generate the material previews. Hold Ctrl to clear the cache and regenerate everything (or use the arrow menu).">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
                                            <Setter Property="Content" Value="Generate Materials" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCtrlKeyPressed}" Value="True">
                                                    <Setter Property="Content" Value="Clear Cache and Regenerate" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button
                                    x:Name="GenerateMaterialsMenuButton"
                                    Grid.Column="1"
                                    Margin="0,4,4,4"
                                    Padding="6,0"
                                    Foreground="{DynamicResource WolvenKitYellow}"
                                    IsEnabled="{Binding IsLoadingMaterials,
                                                        Converter={StaticResource InvertBooleanConverter}}"
                                    Content="&#x25BE;"
                                    ToolTip="More options"
                                    PreviewMouseLeftButtonDown="GenerateMaterialsMenuButton_OnPreviewMouseLeftButtonDown">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Generate Materials" Command="{Binding LoadMaterialsCommand}" />
                                            <MenuItem Header="Clear Cache and Regenerate" Command="{Binding RegenerateMaterialsCommand}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>

                                <CheckBox
                                    Grid.Column="2"
                                    Margin="2,4,6,4"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding LiveMaterialUpdate}"
                                    ToolTip="Live update: after Generate Materials, follow edits. Changing the mesh's materials in this document, or saving its .mi / .mlsetup / .mlmask / .mltemplate / .xbm / .hp files in the project, updates the preview. Only the changed materials are rebuilt."
                                    Content="Live" />

                                <CheckBox
                                    Grid.Column="3"
                                    Margin="2,4,6,4"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding BlendDecalsIntoSurfaces}"
                                    ToolTip="Blend decals into the surface under them, as the game does: colour, normal and roughness / metalness of mesh decals are baked into the skin or material they lie on, which is then lit as one surface. Off: decals are drawn as their own meshes (faster, but lit differently). Decals on multilayer materials are always drawn on their own for now."
                                    Content="Blend decals" />
                            </Grid>
                        </Grid>

                        <!-- Export Materials: bake every material to PNG; multilayer at the chosen size -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                Grid.Column="0"
                                MinWidth="80"
                                Margin="{DynamicResource WolvenKitMarginTiny}"
                                ItemsSource="{Binding MultilayerExportResolutions}"
                                SelectedItem="{Binding MultilayerExportResolution}"
                                ToolTip="Size of the exported multilayer maps (px); other materials keep the size of their textures" />
                            <Button
                                Grid.Column="1"
                                Margin="{DynamicResource WolvenKitMarginTiny}"
                                Padding="{DynamicResource WolvenKitMarginTiny}"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding IsLoadingMaterials, Converter={StaticResource InvertBooleanConverter}}"
                                Command="{Binding ExportMaterialsCommand}"
                                ToolTip="Bake all materials of this appearance to _d (sRGB), _n (OpenGL, Non-Color), _rm (G roughness, B metalness, Non-Color) and _emissive PNGs in a folder you choose. Multilayer maps use the size on the left."
                                Content="Bake / Export Materials..." />
                        </Grid>

                        <Border Background="{DynamicResource WolvenKitRed}"
                                CornerRadius="{DynamicResource WolvenKitTinyRadius}"
                                Margin="{DynamicResource WolvenKitMarginTiny}"
                                Padding="{DynamicResource WolvenKitMarginTiny}"
                                HorizontalAlignment="Stretch">
                            <TextBlock Text="The material preview is experimental and may be incorrect in some cases."
                                       Foreground="White"
                                       FontWeight="Regular"
                                       HorizontalAlignment="Stretch"
                                       FontSize="{DynamicResource WolvenKitFontBody}"/>
                        </Border>
                    </StackPanel>
                </Expander>

                <!-- Export (entities): appearance with rig -->
                <Expander
                    Margin="{DynamicResource WolvenKitMarginTiny}"
                    Header="Export"
                    Visibility="{Binding PanelVisibility.ShowExportEntity, Converter={StaticResource VisibilityConverter}}"
                    IsExpanded="{Binding IsExportSectionExpanded}">
                    <Button
                        Margin="{DynamicResource WolvenKitMarginTiny}"
                        Padding="{DynamicResource WolvenKitMarginTiny}"
                        HorizontalAlignment="Stretch"
                        Foreground="{DynamicResource WolvenKitYellow}"
                        Command="{Binding ExportEntityCommand}"
                        ToolTip="This feature is experimental"
                        Content="Export Appearance with Rig" />
                </Expander>

                <Expander
                    Margin="{DynamicResource WolvenKitMarginTiny}"
                    Header="Image &amp; Icons"
                    Visibility="{Binding IsObjectPreview, Converter={StaticResource VisibilityConverter}}"
                    IsExpanded="{Binding IsImageSectionExpanded}">
                    <StackPanel Orientation="Vertical">
                        <!-- Save Preview Image: the current view as a PNG with a transparent background (icons) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                Grid.Column="0"
                                MinWidth="80"
                                Margin="{DynamicResource WolvenKitMarginTiny}"
                                ItemsSource="{Binding PreviewImageFormats}"
                                SelectedItem="{Binding PreviewImageFormat}"
                                DisplayMemberPath="Label"
                                ToolTip="Size of the saved image (px). Icon sizes follow the modding wiki: clothing up to 160 × 160, guns 320 × 80–160, melee 320 × 60–145. Custom... sets any size. The object keeps its proportions." />
                            <Button
                                Grid.Column="1"
                                Margin="{DynamicResource WolvenKitMarginTiny}"
                                Padding="{DynamicResource WolvenKitMarginTiny}"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding IsLoadingMaterials, Converter={StaticResource InvertBooleanConverter}}"
                                Click="SavePreviewImage_OnClick"
                                ToolTip="Save the current view as a PNG with a transparent background, e.g. for an inventory icon. The object is cropped and centered; zoom in or enlarge the preview for a sharper result."
                                Content="Save Preview Image..." />
                        </Grid>

                        <!-- Custom size (when "Custom..." is selected) -->
                        <Grid Visibility="{Binding IsCustomImageSize, Converter={StaticResource VisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Margin="{DynamicResource WolvenKitMarginTiny}" VerticalAlignment="Center" Text="Width" />
                            <TextBox Grid.Column="1" Margin="{DynamicResource WolvenKitMarginTiny}" Text="{Binding CustomImageWidth, UpdateSourceTrigger=LostFocus}" ToolTip="Image width in pixels (16 to 8192)" />
                            <TextBlock Grid.Column="2" Margin="{DynamicResource WolvenKitMarginTiny}" VerticalAlignment="Center" Text="Height" />
                            <TextBox Grid.Column="3" Margin="{DynamicResource WolvenKitMarginTiny}" Text="{Binding CustomImageHeight, UpdateSourceTrigger=LostFocus}" ToolTip="Image height in pixels (16 to 8192)" />
                        </Grid>

                        <!-- Layout and quality of the saved image -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="{DynamicResource WolvenKitMarginTiny}" VerticalAlignment="Center" Text="Margin %" />
                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="{DynamicResource WolvenKitMarginTiny}"
                                      ItemsSource="{Binding PreviewImageMargins}" SelectedItem="{Binding PreviewImageMargin}"
                                      ToolTip="Empty space around the item, in percent of the shorter side" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Margin="{DynamicResource WolvenKitMarginTiny}" VerticalAlignment="Center" Text="Align" />
                            <ComboBox Grid.Row="0" Grid.Column="3" Margin="{DynamicResource WolvenKitMarginTiny}"
                                      ItemsSource="{Binding PreviewImageAlignments}" SelectedItem="{Binding PreviewImageAlignment}"
                                      ToolTip="Center the item, or stand it on the bottom margin (shoes, props)" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="{DynamicResource WolvenKitMarginTiny}" VerticalAlignment="Center" Text="Background" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="{DynamicResource WolvenKitMarginTiny}"
                                      ItemsSource="{Binding PreviewBackgrounds}" SelectedItem="{Binding PreviewBackground}"
                                      DisplayMemberPath="Label"
                                      ToolTip="Transparent, or a solid colour (e.g. white to mask the icon in an image editor)" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="{DynamicResource WolvenKitMarginTiny}" VerticalAlignment="Center" Text="Quality ×" />
                            <ComboBox Grid.Row="1" Grid.Column="3" Margin="{DynamicResource WolvenKitMarginTiny}"
                                      ItemsSource="{Binding PreviewSupersampleFactors}" SelectedItem="{Binding PreviewSupersample}"
                                      ToolTip="Supersampling: render the preview this many times larger for the capture, then scale down. Cleaner edges, and large images no longer depend on the window size. The preview flickers briefly while capturing." />
                        </Grid>

                        <!-- Appearance icons: one icon per picked appearance -->
                        <Button
                            Margin="{DynamicResource WolvenKitMarginTiny}"
                            Padding="{DynamicResource WolvenKitMarginTiny}"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{Binding IsLoadingMaterials, Converter={StaticResource InvertBooleanConverter}}"
                            Click="SaveAppearanceIcons_OnClick"
                            Visibility="{Binding IsObjectPreview, Converter={StaticResource VisibilityConverter}}"
                            ToolTip="Pick appearances, then save one icon per appearance into a folder as &lt;file&gt;_&lt;appearance&gt;.png: materials are generated and the item is framed for each, with the size, camera, angle and lighting chosen here"
                            Content="Save Appearance Icons..." />
                    </StackPanel>
                </Expander>

                <Expander
                    Margin="{DynamicResource WolvenKitMarginTiny}"
                    Header="Camera"
                    Visibility="{Binding IsObjectPreview, Converter={StaticResource VisibilityConverter}}"
                    IsExpanded="{Binding IsCameraSectionExpanded}">
                    <StackPanel Orientation="Vertical">
                        <ComboBox
                            Margin="{DynamicResource WolvenKitMarginTiny}"
                            ItemsSource="{Binding PreviewCameraOptions}"
                            SelectedItem="{Binding PreviewCamera}"
                            DisplayMemberPath="Label"
                            SelectionChanged="PreviewCamera_OnSelectionChanged"
                            ToolTip="Camera projection. A narrow field of view or orthographic removes perspective distortion, so icons of different items line up." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Margin="{DynamicResource WolvenKitMarginTiny}" VerticalAlignment="Center" Text="Lighting" />
                            <ComboBox Grid.Column="1" Margin="{DynamicResource WolvenKitMarginTiny}"
                                      ItemsSource="{Binding PreviewLightingPresets}" SelectedItem="{Binding PreviewLighting}"
                                      SelectionChanged="Lighting_OnSelectionChanged"
                                      ToolTip="Default: the usual work lights. Icon (soft): soft key light from the front upper left, fill and rim light. Icon (follow camera): the same, turning with the camera. Flat: ambient only, no highlights. Applies to the preview and to saved images." />
                        </Grid>
                        <WrapPanel Margin="{DynamicResource WolvenKitMarginTiny}" Orientation="Horizontal">
                            <Button
                                Margin="1"
                                Padding="4,2"
                                Tag="Front"
                                Click="StandardView_OnClick"
                                ToolTip="Look at the front and frame the object"
                                Content="Front" />
                            <Button
                                Margin="1"
                                Padding="4,2"
                                Tag="Back"
                                Click="StandardView_OnClick"
                                ToolTip="Look at the back and frame the object"
                                Content="Back" />
                            <Button
                                Margin="1"
                                Padding="4,2"
                                Tag="Left"
                                Click="StandardView_OnClick"
                                ToolTip="Look from the left and frame the object"
                                Content="Left" />
                            <Button
                                Margin="1"
                                Padding="4,2"
                                Tag="Right"
                                Click="StandardView_OnClick"
                                ToolTip="Look from the right and frame the object"
                                Content="Right" />
                            <Button
                                Margin="1"
                                Padding="4,2"
                                Tag="Top"
                                Click="StandardView_OnClick"
                                ToolTip="Look from above and frame the object"
                                Content="Top" />
                            <Button
                                x:Name="ThreeQuarterButton"
                                MinWidth="52"
                                Margin="1"
                                Padding="4,2"
                                Tag="ThreeQuarter"
                                Click="StandardView_OnClick"
                                ToolTip="Three-quarter view, slightly from above. Click again to go around: front-right (FR), front-left (FL), back-left (BL), back-right (BR)"
                                Content="3/4" />
                        </WrapPanel>
                    </StackPanel>
                </Expander>

                <Expander
                    Margin="{DynamicResource WolvenKitMarginTiny}"
                    Header="Shader Debug"
                    Visibility="{Binding IsObjectPreview, Converter={StaticResource VisibilityConverter}}"
                    IsExpanded="{Binding IsDebugSectionExpanded}">
                    <StackPanel Orientation="Vertical">
                        <!-- Multilayer shader debug view (temporary, for comparing with the bake / Blender) -->
                        <Grid Visibility="{Binding UseMultilayerShader, Converter={StaticResource VisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ComboBox
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="{DynamicResource WolvenKitMarginTiny}"
                                SelectedIndex="{Binding MultilayerDebugMode}"
                                ToolTip="View of the selected multilayer material: shaded, single channels, which layer covers where (Layer coverage), a layer's mask with microblend (Layer mask) or how often its textures repeat (Layer tiling)">
                                <ComboBoxItem Content="Shaded" />
                                <ComboBoxItem Content="Albedo (unlit)" />
                                <ComboBoxItem Content="Roughness" />
                                <ComboBoxItem Content="Metalness" />
                                <ComboBoxItem Content="Normal (tangent)" />
                                <ComboBoxItem Content="Layer coverage" />
                                <ComboBoxItem Content="Layer mask" />
                                <ComboBoxItem Content="Layer tiling" />
                            </ComboBox>
                            <!-- Solo: pick a multilayer material (also follows the tree selection) and one of its layers -->
                            <ComboBox
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="{DynamicResource WolvenKitMarginTiny}"
                                ItemsSource="{Binding MultilayerDebugMaterials}"
                                SelectedItem="{Binding SelectedMultilayerDebugMaterial}"
                                DisplayMemberPath="Label"
                                ToolTip="Multilayer material for the solo views (selecting a submesh in the tree picks its material)" />
                            <ComboBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="{DynamicResource WolvenKitMarginTiny}"
                                ItemsSource="{Binding MultilayerDebugLayers}"
                                SelectedItem="{Binding SelectedMultilayerDebugLayer}"
                                DisplayMemberPath="Label"
                                ToolTip="Show one layer of the selected material (mlsetup layer number and template); other materials show all layers" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Button Click="ReloadModels" Content="Zoom to Extents" / -->

                <!-- Button Command="{Binding ExtractShadersCommand}" Content="Export Shaders" / -->
            </StackPanel>

            <!--syncfusion:SfTreeGrid
                Grid.Row="1"
                AllowResizingColumns="True"
                AutoExpandMode="AllNodesExpanded"
                AutoGenerateColumns="False"
                CheckBoxMappingName="IsEnabled"
