                        <syncfusion:TreeGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <syncfusion:ComboBoxAdv
                                    AllowMultiSelect="True"
                                    Background="{DynamicResource WolvenKitGray25}"
                                    BorderThickness="0"
