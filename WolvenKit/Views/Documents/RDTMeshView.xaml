                ItemsSource="{Binding SelectedAppearance.Models, Mode=TwoWay}"
                NodeCheckStateChanged="SfTreeGrid_NodeCheckStateChanged"
                ParentPropertyName="Name"
                RowHeaderWidth="300"
                ShowCheckBox="True">
