<UserControl
    x:Class="WolvenKit.Views.Templates.DisplayAsResourcePathEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editors="clr-namespace:WolvenKit.Views.Editors"
    xmlns:helpers="clr-namespace:WolvenKit.Functionality.Helpers"
    xmlns:local="clr-namespace:WolvenKit.Views.Templates"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type={x:Type local:DisplayAsResourcePathEditor}}"
    d:DesignWidth="400"
    d:DesignHeight="32"
    KeyboardNavigation.TabNavigation="Local">
    <Grid DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:DisplayAsResourcePathEditor}}}">
        <Grid.RowDefinitions>
            <RowDefinition MinHeight="{DynamicResource WolvenKitRedEditorRowMinHeight}" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="TextBlock" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{DynamicResource WolvenKitRedEditorHashWidth}" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Row="0"
            Grid.Column="0"
            BorderBrush="{StaticResource BorderAlt}"
            BorderThickness="0,0,1,0" />

        <!-- DepotPath -->
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Margin="{DynamicResource WolvenKitMarginTiny}"
            Padding="0,0,0,1"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            FontSize="{DynamicResource WolvenKitFontSubTitle}"
            Text="DepotPath" />

        <editors:TrimmingTextBox
            Grid.Row="0"
            Grid.Column="1"
            Margin="0,0,0,1"
            FontSize="{DynamicResource WolvenKitFontSubTitle}"
            helpers:TextBoxBehavior.TripleClickSelectAll="True"
            KeyboardNavigation.TabIndex="1"
            Text="{Binding DepotPath,
                           UpdateSourceTrigger=PropertyChanged,
                           Mode=TwoWay}" />

        <Border
            Grid.Row="0"
            Grid.Column="2"
            BorderBrush="{StaticResource BorderAlt}"
            BorderThickness="1,0,0,0" />

        <!-- Hash -->
        <TextBox
            x:Name="HashBox"
            Grid.Row="0"
            Grid.Column="2"
            Margin="1,0,0,1"
            VerticalContentAlignment="Center"
            Background="{StaticResource ContentBackgroundAlt}"
            Foreground="#666666"
            FontSize="{DynamicResource WolvenKitFontSubTitle}"
            helpers:TextBoxBehavior.TripleClickSelectAll="True"
            DataObject.Pasting="HashBox_OnPasting"
            KeyboardNavigation.TabIndex="2"
            PreviewTextInput="HashBox_OnPreviewTextInput"
            Text="{Binding Hash,
                           UpdateSourceTrigger=PropertyChanged,
                           Mode=TwoWay}" />
    </Grid>
</UserControl>
