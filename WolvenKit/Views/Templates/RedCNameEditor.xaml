<UserControl
    x:Class="WolvenKit.Views.Editors.RedCNameEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:WolvenKit.Functionality.Helpers"
    xmlns:local="clr-namespace:WolvenKit.Views.Editors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="400"
    d:DesignHeight="100">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style
                x:Key="CNameStyle"
                TargetType="TextBox">
                <!--  e.g. an empty CName (None): same color as other input controls, follows the theme  -->
                <Setter Property="Background" Value="{DynamicResource BackgroundColor_Control}" />
                <Style.Triggers>
                    <DataTrigger
                        Binding="{Binding IsValid}"
                        Value="True">
                        <!-- <Setter Property="BorderBrush" Value="{StaticResource BackgroundColor_Frame_Active}" /> -->
                        <Setter Property="Background" Value="{DynamicResource ContentBackgroundAlt2}" />
                    </DataTrigger>

                    <DataTrigger
                        Binding="{Binding HasWarning}"
                        Value="True">
                        <!--<Setter Property="BorderBrush" Value="{StaticResource BackgroundColor_Yellow}" />-->
                        <Setter Property="Background" Value="{DynamicResource BackgroundColor_Yellow_Dark}" />
                    </DataTrigger>

                    <DataTrigger
                        Binding="{Binding HasError}"
                        Value="True">
                        <!--<Setter Property="BorderBrush" Value="{StaticResource BackgroundColor_Red}" />-->
                        <Setter Property="Background" Value="{DynamicResource BackgroundColor_Red_Dark}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        Margin="0"
        DataContext="{Binding RelativeSource={RelativeSource FindAncestor,
                                                             AncestorType={x:Type local:RedCNameEditor}}}">
        <Grid.RowDefinitions>
            <RowDefinition MinHeight="{DynamicResource WolvenKitRedEditorRowMinHeight}" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{DynamicResource WolvenKitRedEditorHashWidth}" />
        </Grid.ColumnDefinitions>

        <TextBox
            x:Name="TextBox"
            Grid.Column="0"
            Margin="0"
            Padding="{DynamicResource WolvenKitMarginTinyHorizontal}"
            VerticalContentAlignment="Center"
            BorderThickness="0"
            FontSize="{DynamicResource WolvenKitFontSubTitle}"
            Style="{StaticResource CNameStyle}"
            helpers:TextBoxBehavior.TripleClickSelectAll="True"
            helpers:TextBoxBehavior.IsValid="{Binding IsValid}"
            Text="{Binding Text,
                           UpdateSourceTrigger=PropertyChanged,
                           Mode=TwoWay}"
            ToolTip="{Binding TextBoxToolTip,
                              UpdateSourceTrigger=PropertyChanged,
                              Mode=TwoWay}"
            GotFocus="OnTextboxFocusGained"
            KeyDown="OnTextboxKeyDown"
            LostFocus="OnTextboxFocusLost" />

        <TextBox
            x:Name="HashBox"
            Grid.Column="1"
            Margin="0"
            Padding="{DynamicResource WolvenKitMarginTinyHorizontal}"
            VerticalContentAlignment="Center"
            Background="{DynamicResource ContentBackgroundAlt}"
            BorderBrush="{DynamicResource BorderAlt}"
            BorderThickness="1,0,0,0"
            Foreground="{DynamicResource WolvenKitGray66}"
            FontSize="{DynamicResource WolvenKitFontSubTitle}"
            helpers:TextBoxBehavior.TripleClickSelectAll="True"
            PreviewTextInput="HashBox_OnPreviewTextInput"
            DataObject.Pasting="HashBox_OnPasting"
            Text="{Binding Hash,
                           UpdateSourceTrigger=PropertyChanged,
                           Mode=TwoWay}" />
    </Grid>
</UserControl>
