<reactiveUi:ReactiveUserControl
    x:Class="WolvenKit.Views.Dialogs.ExtractEmbeddedFileDialog"
    x:TypeArguments="dialogs:ExtractEmbeddedFileDialogViewModel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:WolvenKit.App.ViewModels.Dialogs;assembly=WolvenKit.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveUi="http://reactiveui.net"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=dialogs:ExtractEmbeddedFileDialogViewModel}"
    MinWidth="{DynamicResource WolvenKitDialogWidthSmall}"
    MaxWidth="{DynamicResource WolvenKitDialogWidth}"
    Padding="{DynamicResource WolvenKitMargin}"
    Background="{DynamicResource ContentBackgroundAlt3}">
    <StackPanel Margin="{DynamicResource WolvenKitMarginMicro}">
        <TextBlock
            Margin="{DynamicResource WolvenKitMarginSmallBottom}"
            FontSize="{DynamicResource WolvenKitFontMedium}"
            Text="Extract Embedded File" />
        <hc:TextBox
            Margin="{DynamicResource WolvenKitMarginSmallBottom}"
            Text="{Binding NewFilePath}" />
        <TextBlock
            Margin="{DynamicResource WolvenKitMarginSmallBottom}"
            Foreground="{DynamicResource WolvenKitYellow}"
            Text="Custom path the embedded file to avoid collisions with vanilla or modded files."
            TextWrapping="Wrap" />
        <StackPanel
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Style="{StaticResource WKButtonStyle}"
                Margin="{DynamicResource WolvenKitMarginSmallLeft}"
                MinWidth="80"
                Content="Cancel"
                Click="CancelButton_OnClick" />
            <Button
                Style="{StaticResource WKButtonPrimaryStyle}"
                Margin="{DynamicResource WolvenKitMarginSmallLeft}"
                MinWidth="80"
                Content="Extract"
                Click="ExtractButton_OnClick" />
        </StackPanel>
    </StackPanel>
</reactiveUi:ReactiveUserControl>
