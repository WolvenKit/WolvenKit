<Window
    x:Class="WolvenKit.Views.Dialogs.CreateCCXLHairFilesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:helpers="clr-namespace:WolvenKit.Functionality.Helpers"
    Title="Convert hair to CCXL material"
    MinWidth="{DynamicResource WolvenKitDialogWidthSmall}"
    MinHeight="{DynamicResource WolvenKitDialogHeightSmall}"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterScreen">

    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        hc:ThemeManager.RequestedAccentColor="{DynamicResource MahApps.Brushes.Accent3}">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <hc:ThemeResources />
                    <hc:Theme />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <syncfusion:WizardControl
            CancelButtonCancelsWindow="True"
            FinishButtonClosesWindow="True"
            Finish="WizardControl_OnFinish">
            <syncfusion:WizardPage
                BackVisibility="Collapsed"
                CancelVisibility="Visible"
                FinishVisibility="Visible"
                HelpVisibility="Collapsed"
                NextVisibility="Collapsed"
                PreviewKeyDown="WizardPage_PreviewKeyDown"
                PageType="Exterior">
                <Grid
                    Margin="{DynamicResource WolvenKitMarginTiny}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidthLarge}" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Background="#252525"
                        BorderThickness="0"
                        Content="Hair Name:" />
                    <TextBox
                        x:Name="FileHairModName"
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="{StaticResource WolvenKitMarginTinyBottom}"
                        helpers:TextBoxBehavior.FocusGainedSelectAll="True"
                        Text="{Binding HairmodName,
                                       UpdateSourceTrigger=PropertyChanged}"
                        KeyboardNavigation.TabIndex="6" />

                    <Label
                        Grid.Row="2"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Background="#252525"
                        BorderThickness="0"
                        Content="Ink CC file:" />
                    <ComboBox
                        x:Name="InkCCDropdown"
                        Grid.Row="2"
                        Grid.Column="2"
                        helpers:TextBoxBehavior.FocusGainedSelectAll="True"
                        ItemsSource="{Binding InkCCFileOption,
                                              UpdateSourceTrigger=PropertyChanged}"
                        SelectedItem="{Binding SelectedInkCCFile}"
                        KeyboardNavigation.TabIndex="1" />
                    <Label
                        Grid.Row="4"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Background="#252525"
                        BorderThickness="0"
                        Content="Main hair App File:" />
                    <ComboBox
                        x:Name="MainAppDropdown"
                        Grid.Row="4"
                        Grid.Column="2"
                        helpers:TextBoxBehavior.FocusGainedSelectAll="True"
                        ItemsSource="{Binding AppFileOption,
                                              UpdateSourceTrigger=PropertyChanged}"
                        SelectedItem="{Binding SelectedMainAppFile}"
                        KeyboardNavigation.TabIndex="1" />
                    <Label
                        Grid.Row="6"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Background="#252525"
                        BorderThickness="0"
                        Content="Cyberware hair App File:" />
                    <ComboBox
                        x:Name="CybAppDropdown"
                        Grid.Row="6"
                        Grid.Column="2"
                        helpers:TextBoxBehavior.FocusGainedSelectAll="True"
                        ItemsSource="{Binding AppFileOption,
                                              UpdateSourceTrigger=PropertyChanged}"
                        SelectedItem="{Binding SelectedCybAppFile}"
                        KeyboardNavigation.TabIndex="1" />
                    <Label
                        Grid.Row="8"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Background="#252525"
                        BorderThickness="0"
                        Content="Shadow hair App File:" />
                    <ComboBox
                        x:Name="ShadowAppDropdown"
                        Grid.Row="8"
                        Grid.Column="2"
                        helpers:TextBoxBehavior.FocusGainedSelectAll="True"
                        ItemsSource="{Binding AppFileOption,
                                              UpdateSourceTrigger=PropertyChanged}"
                        SelectedItem="{Binding SelectedShadowAppFile}"
                        KeyboardNavigation.TabIndex="1" />

                    <Label
                        Grid.Row="10"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Background="#252525"
                        BorderThickness="0"
                        Content="Main hair Mesh File:" />
                    <ComboBox
                        x:Name="MainMeshDropdown"
                        Grid.Row="10"
                        Grid.Column="2"
                        helpers:TextBoxBehavior.FocusGainedSelectAll="True"
                        ItemsSource="{Binding MeshFileOption,
                                              UpdateSourceTrigger=PropertyChanged}"
                        SelectedItem="{Binding SelectedMainMeshFile}"
                        KeyboardNavigation.TabIndex="1" />
                    <Label
                        Grid.Row="12"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Background="#252525"
                        BorderThickness="0"
                        Content="Cyberware hair Mesh File:" />
                    <ComboBox
                        x:Name="CybMeshDropdown"
                        Grid.Row="12"
                        Grid.Column="2"
                        helpers:TextBoxBehavior.FocusGainedSelectAll="True"
                        ItemsSource="{Binding MeshFileOption,
                                              UpdateSourceTrigger=PropertyChanged}"
                        SelectedItem="{Binding SelectedCybMeshFile}"
                        KeyboardNavigation.TabIndex="1" />
                    <Label
                        Grid.Row="14"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Background="#252525"
                        BorderThickness="0"
                        Content="Shadow hair Mesh File:" />
                    <ComboBox
                        x:Name="ShadowMeshDropdown"
                        Grid.Row="14"
                        Grid.Column="2"
                        helpers:TextBoxBehavior.FocusGainedSelectAll="True"
                        ItemsSource="{Binding MeshFileOption,
                                              UpdateSourceTrigger=PropertyChanged}"
                        SelectedItem="{Binding SelectedShadowMeshFile}"
                        KeyboardNavigation.TabIndex="1" />

                </Grid>
            </syncfusion:WizardPage>
        </syncfusion:WizardControl>
    </Grid>


</Window>
