                        Grid.Column="3">
                        Pubic Hair Color
                    </Label>

                    <ComboBox
                        Name="ComboboxPubicHairColor"
                        Grid.Row="4"
                        Grid.Column="4"
                        Width="{DynamicResource WolvenkitControlMinWidth}"
                        Margin="{DynamicResource WolvenKitMarginBottom}"
                        HorizontalAlignment="Left"
                        Visibility="{Binding IsPubesEnabled,
                                             Mode=OneWay,
                                             UpdateSourceTrigger=PropertyChanged,
                                             Converter={StaticResource BooleanVisibilityConverter}}"
                        ItemsSource="{StaticResource HairColorListboxItems}"
                        SelectedIndex="{Binding PubicHairColor}" />

                </Grid>

            </StackPanel>

        </syncfusion:WizardPage>

        <!-- Wizard: page 2 (Face) -->
