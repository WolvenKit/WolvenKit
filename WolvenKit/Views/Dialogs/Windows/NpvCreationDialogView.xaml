        Help="WizardControl_OnHelpButtonClicked"
        CancelButtonCancelsWindow="True"
        FinishButtonClosesWindow="True"
        CancelVisible="True"
        HelpVisible="True">

        <!-- Wizard: page 3 -->
        <syncfusion:WizardPage
            Name="BodyPage"
            Title="Body options"
            Height="Auto"
            FinishVisibility="Visible"
            NextVisible="False"
            PreviewKeyDown="WizardPage_PreviewKeyDown"
            BannerBackground="{DynamicResource BackgroundBrush}"
            Description="Pick your body parts."
            PreviousPage="{Binding ElementName=FaceOptionsPage}">

            <StackPanel
                Margin="{DynamicResource WolvenKitMarginHorizontal}"
                Orientation="Vertical">

                <!-- Body -->
                <Label Style="{StaticResource SectionHeaderStyle}">
                    Body
                </Label>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />

                    </Grid.ColumnDefinitions>

                    <!-- Nails -->
                    <Label
                        Grid.Row="0"
                        Grid.Column="0">
                        Nails
                    </Label>
                    <ComboBox
                        Name="ComboboxNails"
                        Grid.Row="0"
                        Grid.Column="1"
                        Width="{DynamicResource WolvenkitControlMinWidth}"
                        Margin="{DynamicResource WolvenKitMarginBottom}"
                        HorizontalAlignment="Left"
                        ItemsSource="{StaticResource NailsListBoxItems}"
                        SelectedIndex="{Binding Nails}" />

                    <!-- Body Scars -->
                    <Label
                        Grid.Row="2"
                        Grid.Column="0">
                        Body Scars
                    </Label>
