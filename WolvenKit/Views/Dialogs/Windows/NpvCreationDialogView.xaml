                        Name="ComboboxBodyScars"
                        Grid.Row="2"
                        Grid.Column="1"
                        Width="{DynamicResource WolvenkitControlMinWidth}"
                        Margin="{DynamicResource WolvenKitMarginBottom}"
                        HorizontalAlignment="Left"
                        ItemsSource="{StaticResource BodyScarListBoxItems}"
                        SelectedIndex="{Binding BodyScars}" />

                </Grid>

                <Label Style="{StaticResource SectionHeaderStyle}">
                    Hair
                </Label>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />
                    </Grid.ColumnDefinitions>
                    <Label
                        Grid.Row="0"
                        Grid.Column="0">
                        Hair
                    </Label>
                    <ComboBox
                        Name="ComboboxHair"
                        Grid.Row="0"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Width="{DynamicResource WolvenkitControlMinWidth}"
                        Margin="{DynamicResource WolvenKitMarginBottom}"
                        HorizontalAlignment="Left"
                        ItemsSource="{StaticResource HairListboxItems}"
                        SelectedIndex="{Binding Hair}" />
                    <Label
                        Grid.Row="0"
                        Grid.Column="3">
                        Hair Color
                    </Label>
                    <ComboBox
                        Name="ComboboxHairColor"
                        Grid.Row="0"
                        Grid.Column="4"
                        Width="{DynamicResource WolvenkitControlMinWidth}"
                        Margin="{DynamicResource WolvenKitMarginBottom}"
                        HorizontalAlignment="Left"
                        ItemsSource="{StaticResource HairColorListboxItems}"
                        SelectedIndex="{Binding HairColor}" />

                    <!-- Beard -->
                    <Label
                        Grid.Row="2"
                        Grid.Column="0"
                        Visibility="{Binding Path=BodyGenderMale,
                                             Converter={StaticResource BooleanToVisibilityConverter}}">
                        Beard
                    </Label>
                    <ComboBox
                        Name="ComboboxBeard"
                        Grid.Row="2"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Width="{DynamicResource WolvenkitControlMinWidth}"
                        Margin="{DynamicResource WolvenKitMarginBottom}"
                        HorizontalAlignment="Left"
                        Visibility="{Binding Path=BodyGenderMale,
                                             Converter={StaticResource BooleanToVisibilityConverter}}"
                        ItemsSource="{StaticResource BeardListBoxItems}"
                        SelectedIndex="{Binding Beard}" />

                    <!-- Beard Style -->
                    <Label
                        Grid.Row="2"
                        Grid.Column="3"
                        Visibility="{Binding Path=BodyGenderMale,
                                             Converter={StaticResource BooleanToVisibilityConverter}}">
                        Beard Style
                    </Label>
                    <ComboBox
                        Name="ComboboxBeardStyle"
                        Grid.Row="2"
                        Grid.Column="4"
                        Width="{DynamicResource WolvenkitControlMinWidth}"
                        Margin="{DynamicResource WolvenKitMarginBottom}"
                        HorizontalAlignment="Left"
                        Visibility="{Binding Path=IsBeardEnabled,
                                             Converter={StaticResource BooleanToVisibilityConverter}}"
                        ItemsSource="{StaticResource BeardStyleListBoxItems}"
                        SelectedIndex="{Binding BeardStyle}" />

                    <!-- Beard Color -->
                    <Label
                        Grid.Row="4"
                        Grid.Column="3"
                        Visibility="{Binding Path=IsBeardEnabled,
                                             Converter={StaticResource BooleanToVisibilityConverter}}">
                        Beard Color
                    </Label>
                    <ComboBox
                        Name="ComboboxBeardColor"
                        Grid.Row="4"
                        Grid.Column="4"
                        Width="{DynamicResource WolvenkitControlMinWidth}"
                        Margin="{DynamicResource WolvenKitMarginBottom}"
                        HorizontalAlignment="Left"
                        Visibility="{Binding Path=IsBeardEnabled,
                                             Converter={StaticResource BooleanToVisibilityConverter}}"
                        ItemsSource="{StaticResource HairColorListboxItems}"
