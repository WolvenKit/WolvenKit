            Name="FaceOptionsPage"
            Title="Face options"
            Height="Auto"
            FinishVisibility="Visible"
            NextVisible="True"
            PreviewKeyDown="WizardPage_PreviewKeyDown"
            BannerBackground="{DynamicResource BackgroundBrush}"
            Description="Pick your cyberware, make-up etc."
            PreviousPage="{Binding ElementName=InitialConfigPage}"
            NextPage="{Binding ElementName=BodyPage}">

            <StackPanel
                Margin="{DynamicResource WolvenKitMarginHorizontal}"
                Orientation="Vertical">

                <Label Style="{StaticResource SectionHeaderStyle}">
                    Eyes
                </Label>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />

                    </Grid.ColumnDefinitions>

                    <!-- Eye Stuff -->
                    <Label
                        Grid.Row="0"
                        Grid.Column="0">
                        Eye Color
                    </Label>
                    <ComboBox
                        Name="ComboboxEyeColor"
                        Grid.Row="0"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Width="{DynamicResource WolvenkitControlMinWidth}"
                        Margin="{DynamicResource WolvenKitMarginBottom}"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding EyeColorListBoxItems}"
                        SelectedIndex="{Binding EyeColor}" />
                    <Label
                        Grid.Row="0"
                        Grid.Column="3">
                        Eyelash Color
                    </Label>
                    <ComboBox
                        Name="ComboboxEyelashColor"
                        Grid.Row="0"
                        Grid.Column="4"
                        Width="{DynamicResource WolvenkitControlMinWidth}"
                        Margin="{DynamicResource WolvenKitMarginBottom}"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding EyelashColorListBoxItems}"
                        SelectedIndex="{Binding EyelashColor}" />


                    <!-- Eye Make-Up -->
                    <Label
                        Grid.Row="2"
                        Grid.Column="0">
                        Eye Make-Up
                    </Label>
                    <ComboBox
                        Name="ComboboxEyeMakeUp"
                        Grid.Row="2"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Width="{DynamicResource WolvenkitControlMinWidth}"
                        Margin="{DynamicResource WolvenKitMarginBottom}"
                        HorizontalAlignment="Left"
                        ItemsSource="{StaticResource MakeupOptionsListboxItems20}"
                        SelectedIndex="{Binding EyeMakeup}" />

                    <Label
                        Grid.Row="2"
                        Grid.Column="3"
                        Visibility="{Binding IsEyeMakeupEnabled,
                                             Mode=OneWay,
                                             UpdateSourceTrigger=PropertyChanged,
                                             Converter={StaticResource BooleanToVisibilityConverter}}">
                        Eye Make-Up Color
                    </Label>
                    <ComboBox
                        Name="ComboboxEyeMakeUpColor"
                        Grid.Row="2"
                        Grid.Column="4"
                        Width="{DynamicResource WolvenkitControlMinWidth}"
                        Margin="{DynamicResource WolvenKitMarginBottom}"
                        HorizontalAlignment="Left"
                        Visibility="{Binding IsEyeMakeupEnabled,
                                             Mode=OneWay,
                                             UpdateSourceTrigger=PropertyChanged,
                                             Converter={StaticResource BooleanToVisibilityConverter}}"
                        ItemsSource="{Binding EyeMakeupColorListBoxItems}"
                        SelectedIndex="{Binding EyeMakeup}" />

                </Grid>

                <!-- Cheeks -->
                <Label Style="{StaticResource SectionHeaderStyle}">
                    Cheeks
                </Label>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />

                    </Grid.ColumnDefinitions>

                    <!-- Cyberware -->
                    <Label
                        Grid.Row="0"
                        Grid.Column="0">
                        Cyberware
                    </Label>
                    <ComboBox
                        Name="ComboboxCyberware"
                        Grid.Row="0"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Width="{DynamicResource WolvenkitControlMinWidth}"
                        Margin="{DynamicResource WolvenKitMarginBottom}"
                        HorizontalAlignment="Left"
                        ItemsSource="{StaticResource CyberwareListBoxItems}"
                        SelectedIndex="{Binding Cyberware}" />

                    <Label
                        Grid.Row="2"
                        Grid.Column="0">
                        Cheek Make-Up
                    </Label>

                    <ComboBox
                        Name="ComboboxCheekMakeUp"
                        Grid.Row="2"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Width="{DynamicResource WolvenkitControlMinWidth}"
                        Margin="{DynamicResource WolvenKitMarginBottom}"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding CheekMakeupDropdownOptions}"
                        SelectedIndex="{Binding CheekMakeup}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="3"
                        Margin="{DynamicResource WolvenKitMarginTinyTopLeft}"
                        Visibility="{Binding IsCheekMakeupEnabled,
                                             Mode=OneWay,
                                             UpdateSourceTrigger=PropertyChanged,
                                             Converter={StaticResource BooleanToVisibilityConverter}}"
                        Text="Make-up Color">
                        <TextBlock.Style>
                            <Style.Triggers>
                                <Trigger Property="IsFrecklesEnabled" Value="True">
                                    <Setter Property="Content" Value="Freckle Color" />
                                </Trigger>
                            </Style.Triggers>
                        </TextBlock.Style>
                    </TextBlock>

                    <ComboBox
                        Name="ComboboxCheekMakeUpColor"
                        Grid.Row="2"
                        Grid.Column="4"
                        Width="{DynamicResource WolvenkitControlMinWidth}"
                        Margin="{DynamicResource WolvenKitMarginBottom}"
                        HorizontalAlignment="Left"
                        Visibility="{Binding IsCheekMakeupEnabled,
                                             Mode=OneWay,
                                             UpdateSourceTrigger=PropertyChanged,
                                             Converter={StaticResource BooleanToVisibilityConverter}}"
                        SelectedItem="{Binding CheekMakeupColor}"
                        ItemsSource="{Binding CheekMakeupDropdownOptions}" />

                </Grid>

                <!-- Cheek make-up -->
                <Label Style="{StaticResource SectionHeaderStyle}">
                    Lipstick
                </Label>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />

                    </Grid.ColumnDefinitions>

                    <Label
                        Grid.Row="0"
                        Grid.Column="0">
                        Lipstick Style
                    </Label>
                    <ComboBox
                        Name="ComboboxCheekMakeupStyle"
                        Grid.Row="0"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Width="{DynamicResource WolvenkitControlMinWidth}"
                        Margin="{DynamicResource WolvenKitMarginBottom}"
                        HorizontalAlignment="Left"
                        ItemsSource="{StaticResource LipstickStyleListboxItems}"
                        SelectedIndex="{Binding EyeColor}" />
                    <Label
                        Grid.Row="0"
                        Grid.Column="3"
                        Visibility="{Binding IsLipMakeupEnabled,
                                             Mode=OneWay,
                                             UpdateSourceTrigger=PropertyChanged,
                                             Converter={StaticResource BooleanToVisibilityConverter}}">
                        Lipstick Color
                    </Label>
                    <ComboBox
                        Name="ComboboxLipstickColor"
                        Grid.Row="0"
                        Grid.Column="4"
                        Width="{DynamicResource WolvenkitControlMinWidth}"
                        Margin="{DynamicResource WolvenKitMarginBottom}"
                        HorizontalAlignment="Left"
                        Visibility="{Binding IsLipMakeupEnabled,
                                             Mode=OneWay,
                                             UpdateSourceTrigger=PropertyChanged,
                                             Converter={StaticResource BooleanToVisibilityConverter}}"
                        ItemsSource="{Binding LipstickColorListBoxItems}"
                        SelectedIndex="{Binding LipstickColor}" />
                </Grid>

                <!-- Scars and Tattoos -->
                <Label Style="{StaticResource SectionHeaderStyle}">
                    Scars and Tattoos
                </Label>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />

                    </Grid.ColumnDefinitions>
                    <ComboBox
                        Name="ComboboxFacialTattoos"
                        Grid.Row="0"
                        Grid.Column=""
                        Width="{DynamicResource WolvenkitControlMinWidth}"
                        Margin="{DynamicResource WolvenKitMarginBottom}"
                        HorizontalAlignment="Left"
                        ItemsSource="{StaticResource FacialTattooListBoxItems}"
                        SelectedIndex="{Binding FacialTattoos}" />

                    <!-- Facial Scars -->
                    <Label
                        Grid.Row="0"
                        Grid.Column="0">
                        Facial Scars
                    </Label>
                    <ComboBox
                        Name="ComboboxFacialScars"
                        Grid.Row="0"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Width="{DynamicResource WolvenkitControlMinWidth}"
                        Margin="{DynamicResource WolvenKitMarginBottom}"
                        HorizontalAlignment="Left"
                        ItemsSource="{StaticResource FacialScarListBoxItems}"
                        SelectedIndex="{Binding FacialScars}" />

                    <!-- Facial Tattoos -->
                    <Label
                        Grid.Row="0"
                        Grid.Column="3">
                        Facial Tattoos
                    </Label>


                    <!-- Piercings -->
                    <Label
                        Grid.Row="2"
                        Grid.Column="0">
                        Piercings
                    </Label>
                    <ComboBox
                        Name="ComboboxPiercings"
                        Grid.Row="2"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Width="{DynamicResource WolvenkitControlMinWidth}"
                        Margin="{DynamicResource WolvenKitMarginBottom}"
                        HorizontalAlignment="Left"
                        ItemsSource="{StaticResource PiercingListBoxItems}"
                        SelectedIndex="{Binding Piercings}" />

                </Grid>
            </StackPanel>

        </syncfusion:WizardPage>


        <!-- Wizard: page 1 -->
        <syncfusion:WizardPage
            Name="InitialConfigPage"
            Title="Configure your NPV"
            BannerBackground="{DynamicResource BackgroundBrush}"
            FinishVisibility="Collapsed"
            NextVisibility="Visible"
            BackVisibility="Collapsed"
            NextEnabled="{Binding FormValid}"
            PreviewKeyDown="WizardPage_PreviewKeyDown"
            Description="Enter the numeric values from character creator (check your apartment's mirror)."
            NextPage="{Binding ElementName=FaceOptionsPage}">

            <Grid Margin="{DynamicResource WolvenKitMarginHorizontal}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidth}" />
                    <ColumnDefinition Width="{DynamicResource WolvenKitNewFileIconWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5" />
                </Grid.RowDefinitions>


                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Margin="{DynamicResource WolvenKitMarginBottom}">
                    <Run Text="If you can't see the character creator numbers, install AppearanceChangeUnlocker" />
                    <Hyperlink
                        Style="{StaticResource LinkStyle}"
                        NavigateUri="https://www.nexusmods.com/cyberpunk2077/mods/3850"
                        RequestNavigate="Hyperlink_RequestNavigate">
                        from Nexus
                    </Hyperlink>
                </TextBlock>

                <!-- Name -->
                <Label
                    Grid.Row="2"
                    Grid.Column="0">
                    NPC's Name
                </Label>
                <TextBox
                    Name="TextBoxName"
                    Grid.Row="2"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="{DynamicResource WolvenKitMarginBottom}">
                    <TextBox.Text>
                        <Binding
                            Path="Name"
                            UpdateSourceTrigger="PropertyChanged" />
                    </TextBox.Text>
                </TextBox>

                <Label
                    Grid.Row="4"
                    Grid.Column="0">
                    Folder
                </Label>

                <!-- relative path (project folder) -->
                <editors:FilterableDropdownMenu
                    x:Name="FilterableDropdownMenu"
                    Grid.Row="4"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Label="Target Folder:"
                    Options="{Binding ProjectFolders}"
                    SelectedOption="{Binding DestFolderPath,
                                             Mode=TwoWay}"
                    IsInline="True" />

                <TextBox
                    x:Name="TextBoxFilePath"
                    Grid.Row="6"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="{StaticResource WolvenKitMarginTinyVertical}"
                    helpers:TextBoxBehavior.FocusGainedSelectAll="True"
                    KeyboardNavigation.TabIndex="-1">

                    <TextBox.Text>
                        <Binding
                            Path="DestFolderPath"
                            UpdateSourceTrigger="PropertyChanged" />
                    </TextBox.Text>
                </TextBox>


                <!-- Body Gender -->
                <Label
                    Grid.Row="8"
                    Grid.Column="0">
                    Body Gender
                </Label>

                <ComboBox
                    Name="ComboboxBodyGender"
                    Grid.Row="8"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Width="{DynamicResource WolvenkitControlMinWidth}"
                    Margin="{DynamicResource WolvenKitMarginVertical}"
                    HorizontalAlignment="Left"
                    ItemsSource="{StaticResource BodyGenderListBoxItems}"
                    SelectedItem="{Binding BodyGender}" />

                <!-- Eyes -->
                <Label
                    Grid.Row="10"
                    Grid.Column="0"
                    Margin="{DynamicResource WolvenKitMarginVertical}">
                    Eyes
                </Label>
                <ComboBox
                    Name="ComboboxEyes"
                    Grid.Row="10"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Width="{DynamicResource WolvenkitControlMinWidth}"
                    Margin="{DynamicResource WolvenKitMarginVertical}"
                    HorizontalAlignment="Left"
                    ItemsSource="{StaticResource ShapekeyListBoxItems}"
                    SelectedIndex="{Binding Eyes}" />


                <Label
                    Grid.Row="12"
                    Grid.Column="0">
                    Nose
                </Label>
                <ComboBox
                    Name="ComboboxNose"
                    Grid.Row="12"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Width="{DynamicResource WolvenkitControlMinWidth}"
                    Margin="{DynamicResource WolvenKitMarginBottom}"
                    HorizontalAlignment="Left"
                    ItemsSource="{StaticResource ShapekeyListBoxItems}"
                    SelectedIndex="{Binding Nose}" />

                <Label
                    Grid.Row="14"
                    Grid.Column="0">
                    Mouth
                </Label>
                <ComboBox
                    Name="ComboboxMouth"
                    Grid.Row="14"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Width="{DynamicResource WolvenkitControlMinWidth}"
                    Margin="{DynamicResource WolvenKitMarginBottom}"
                    HorizontalAlignment="Left"
                    ItemsSource="{StaticResource ShapekeyListBoxItems}"
                    SelectedIndex="{Binding Mouth}" />


                <Label
                    Grid.Row="16"
                    Grid.Column="0">
                    Jaw
                </Label>
                <ComboBox
                    Name="ComboboxJaw"
                    Grid.Row="16"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Width="{DynamicResource WolvenkitControlMinWidth}"
                    Margin="{DynamicResource WolvenKitMarginBottom}"
                    HorizontalAlignment="Left"
                    ItemsSource="{StaticResource ShapekeyListBoxItems}"
                    SelectedIndex="{Binding Jaw}" />

                <Label
                    Grid.Row="18"
                    Grid.Column="0">
                    Ears
                </Label>
                <ComboBox
                    Name="ComboboxEars"
                    Grid.Row="18"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Width="{DynamicResource WolvenkitControlMinWidth}"
                    Margin="{DynamicResource WolvenKitMarginBottom}"
                    HorizontalAlignment="Left"
                    ItemsSource="{StaticResource ShapekeyListBoxItems}"
                    SelectedIndex="{Binding Ears}" />
            </Grid>
        </syncfusion:WizardPage>

    </syncfusion:WizardControl>
</Window>
