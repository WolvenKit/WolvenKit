                    <ComboBox
                        Name="ComboboxBoobs"
                        Grid.Row="0"
                        Grid.Column="1"
                        Width="{DynamicResource WolvenkitControlMinWidth}"
                        Margin="{DynamicResource WolvenKitMarginBottom}"
                        HorizontalAlignment="Left"
                        Visibility="{Binding BodyGenderMale,
                                             Mode=OneWay,
                                             UpdateSourceTrigger=PropertyChanged,
                                             Converter={StaticResource InvertBooleanVisibilityConverter}}"
                        ItemsSource="{StaticResource GenitalListBoxItemsSize}"
                        SelectedIndex="{Binding Boobs}" />

                    <Label
                        Grid.Row="0"
                        Grid.Column="3"
