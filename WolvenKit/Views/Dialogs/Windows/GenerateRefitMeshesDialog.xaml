<Window
    x:Class="WolvenKit.Views.Dialogs.Windows.GenerateRefitMeshesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:editors="clr-namespace:WolvenKit.Views.Editors"
    xmlns:templates="clr-namespace:WolvenKit.Views.Templates"
    Title="Generate refit meshes"
    Width="{StaticResource WolvenKitDialogWidth}"
    MinWidth="{StaticResource WolvenKitDialogWidth}"
    MinHeight="{StaticResource WolvenKitDialogHeightSmall}"
    Padding="{DynamicResource WolvenKitMarginTop}"
    Background="{DynamicResource BackgroundColor_Control}"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner">
    <Grid hc:ThemeManager.RequestedAccentColor="{DynamicResource MahApps.Brushes.Accent3}">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <hc:ThemeResources />
                    <hc:Theme />
                </ResourceDictionary.MergedDictionaries>
                <Style
                    x:Key="LabelHeaderStyle"
                    TargetType="Label">
                    <Setter Property="BorderBrush" Value="{DynamicResource WolvenKitBorderBrush}" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="FontSize" Value="{DynamicResource WolvenKitFontMedium}" />
                    <Setter Property="Margin" Value="{DynamicResource WolvenKitMarginBottom}" />
                </Style>
                <Style
                    BasedOn="{StaticResource WolvenkitLabelStyle}"
                    TargetType="{x:Type Label}" />
            </ResourceDictionary>
        </Grid.Resources>

        <syncfusion:WizardControl
            CancelButtonCancelsWindow="True"
            FinishButtonClosesWindow="True">
            <syncfusion:WizardPage
                Margin="{DynamicResource WolvenKitMarginHorizontal}"
                Background="{DynamicResource BackgroundColor_Control}"
                BackVisibility="Collapsed"
                CancelVisibility="Visible"
                FinishVisibility="Visible"
                HelpVisibility="Collapsed"
                NextVisibility="Collapsed"
                PageType="Exterior">
                <Grid
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource WolvenKitDialogLabelColumnWidthMedium}" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{DynamicResource WolvenKitButtonGridWidth}" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="6"
                        Text="Create refit meshes from selected base meshes (you still have to refit yourself)."
                        TextWrapping="Wrap" />

                    <Label
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="6"
                        Style="{StaticResource LabelHeaderStyle}"
                        Content="Fem body gender" />

                    <editors:FilterableDropdownMenu
                        x:Name="FemaleBaseMeshDropdown"
                        Grid.Row="4"
                        Grid.Column="0"
                        Grid.ColumnSpan="6"
                        Label="Base mesh (pwa)"
                        IsInline="True" />

                    <TextBox
                        x:Name="FemaleBaseMeshTextBox"
                        Grid.Row="6"
                        Grid.Column="1"
                        Grid.ColumnSpan="5" />

                    <Label
                        Grid.Row="8"
                        Grid.Column="0"
                        Width="{StaticResource WolvenKitLabelWidthMedium}"
                        HorizontalAlignment="Left"
                        Content="Refits" />

                    <TextBox
                        x:Name="FemaleRefitsTextBox"
                        Grid.Row="8"
                        Grid.Column="1"
                        Grid.ColumnSpan="4"
                        ToolTip="Comma-separated list, e.g. ebbp, ebbrb, ebbwtfbbq" />

                    <Button
                        x:Name="WriteFemaleRefitsButton"
                        Grid.Row="8"
                        Grid.Column="5"
                        Margin="{StaticResource WolvenKitMarginTinyLeft}"
                        Padding="{DynamicResource WolvenKitMarginTinyHorizontal}"
                        ToolTip="Save to Wolvenkit settings"
                        Click="WriteFemaleRefitsButton_OnClick">
                        <templates:IconBox
                            IconPack="Material"
                            Kind="ContentSaveMove"
                            Size="{DynamicResource WolvenKitIconMicro}" />
                    </Button>

                    <Label
                        Grid.Row="10"
                        Grid.Column="0"
                        Grid.ColumnSpan="6"
                        Style="{StaticResource LabelHeaderStyle}"
                        Content="Masc body gender" />

                    <editors:FilterableDropdownMenu
                        x:Name="MaleBaseMeshDropdown"
                        Grid.Row="12"
                        Grid.Column="0"
                        Grid.ColumnSpan="6"
                        Label="Base mesh (pma)"
                        IsInline="True" />

                    <TextBox
                        x:Name="MaleBaseMeshTextBox"
                        Grid.Row="14"
                        Grid.Column="1"
                        Grid.ColumnSpan="5" />

                    <Label
                        Grid.Row="16"
                        Grid.Column="0"
                        Width="{StaticResource WolvenKitLabelWidthMedium}"
                        HorizontalAlignment="Left"
                        Content="Refits" />

                    <TextBox
                        x:Name="MaleRefitsTextBox"
                        Grid.Row="16"
                        Grid.Column="1"
                        Grid.ColumnSpan="4"
                        ToolTip="Comma-separated list, e.g. atlas, gymfiend, ebbwtfbbq" />

                    <Button
                        x:Name="WriteMaleRefitsButton"
                        Grid.Row="16"
                        Grid.Column="5"
                        Margin="{StaticResource WolvenKitMarginTinyLeft}"
                        Padding="{DynamicResource WolvenKitMarginTinyHorizontal}"
                        ToolTip="Save to Wolvenkit settings"
                        Click="WriteMaleRefitsButton_OnClick">
                        <templates:IconBox
                            IconPack="Material"
                            Kind="ContentSaveMove"
                            Size="{DynamicResource WolvenKitIconMicro}" />
                    </Button>
                </Grid>
            </syncfusion:WizardPage>
        </syncfusion:WizardControl>
    </Grid>
</Window>
