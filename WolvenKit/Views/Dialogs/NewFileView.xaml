<reactiveUi:ReactiveUserControl
    x:Class="WolvenKit.Views.Dialogs.NewFileView"
    x:TypeArguments="dialogs:NewFileViewModel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:WolvenKit.App.ViewModels.Dialogs;assembly=WolvenKit.App"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:others="clr-namespace:WolvenKit.Views.Others"
    xmlns:reactiveUi="http://reactiveui.net"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:templates="clr-namespace:WolvenKit.Views.Templates"
    xmlns:controls="clr-namespace:WolvenKit.Views.Controls"
    mc:Ignorable="d"
    d:DesignWidth="800"
    d:DesignHeight="600"
    d:DataContext="{d:DesignInstance Type=dialogs:NewFileViewModel}"
    Width="800"
    Height="600"
    Background="{DynamicResource ContentBackgroundAlt3}">
    <Grid Margin="{DynamicResource WolvenKitMarginSmall}">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="{DynamicResource WolvenKitColumnTiny}" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- TOP FILE SELECTOR -->
        <syncfusion:SfDataGrid
            x:Name="Categories"
            BorderBrush="{DynamicResource WolvenKitGridLine}"
            RowSelectionBrush="{DynamicResource WolvenKitListSelection}"
            CurrentCellBorderThickness="0"
            HeaderRowHeight="{DynamicResource WolvenKitTreeGridRowHeaderHeight}"
            RowHeight="{DynamicResource WolvenKitNewFileRowHeight}"
            ColumnSizer="AutoLastColumnFill"
            AllowFiltering="False"
            AllowSorting="False"
            AutoGenerateColumns="False"
            IsReadOnly="True">
            <syncfusion:SfDataGrid.Resources>
                <!--  grid lines: the theme's, as in the Import / Export tools  -->
                <Style TargetType="syncfusion:GridCell">
                    <Setter Property="BorderBrush" Value="{DynamicResource WolvenKitGridLine}" />
                </Style>
                <Style TargetType="syncfusion:GridHeaderCellControl">
                    <Setter Property="BorderBrush" Value="{DynamicResource WolvenKitGridLine}" />
                </Style>
            </syncfusion:SfDataGrid.Resources>
            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTemplateColumn HeaderText="Category">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="{DynamicResource WolvenKitMarginSmallHorizontal}"
                                VerticalAlignment="Center"
                                Text="{Binding Name}" />
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

        <DockPanel
            Grid.Row="0"
            Grid.Column="2">
            <!-- searches the files of the selected category -->
            <hc:SearchBar
                x:Name="SearchBar"
                DockPanel.Dock="Top"
                Margin="0,0,0,2"
                Background="{DynamicResource BackgroundColor_Frame_Background}"
                BorderBrush="{DynamicResource WolvenKitSearchBorder}"
                BorderThickness="1"
                Style="{StaticResource SearchBarStyle}"
                hc:BorderElement.CornerRadius="0"
                hc:InfoElement.Placeholder="Search files"
                hc:InfoElement.ShowClearButton="True"
                FlowDirection="LeftToRight"
                IsRealTime="True"
                TextChanged="SearchBar_OnTextChanged" />

            <syncfusion:SfDataGrid
                x:Name="DataGrid"
                BorderBrush="{DynamicResource WolvenKitGridLine}"
                RowSelectionBrush="{DynamicResource WolvenKitListSelection}"
                CurrentCellBorderThickness="0"
                HeaderRowHeight="{DynamicResource WolvenKitTreeGridRowHeaderHeight}"
                RowHeight="{DynamicResource WolvenKitNewFileRowHeight}"
                ItemsSourceChanged="DataGrid_OnItemsSourceChanged"
                AutoGenerateColumns="False">
                <syncfusion:SfDataGrid.Resources>
                    <!--  grid lines: the theme's, as in the Import / Export tools  -->
                    <Style TargetType="syncfusion:GridCell">
                        <Setter Property="BorderBrush" Value="{DynamicResource WolvenKitGridLine}" />
                    </Style>
                    <Style TargetType="syncfusion:GridHeaderCellControl">
                        <Setter Property="BorderBrush" Value="{DynamicResource WolvenKitGridLine}" />
                    </Style>
                </syncfusion:SfDataGrid.Resources>
                <syncfusion:SfDataGrid.Columns>

                    <syncfusion:GridTemplateColumn
                        ColumnSizer="AutoLastColumnFill"
                        AllowFiltering="False"
                        AllowSorting="True"
                        HeaderText="File"
                        IsReadOnly="True"
                        MappingName="Name">

                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid
                                    Margin="{DynamicResource WolvenKitMarginTinyVertical}"
                                    VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{DynamicResource WolvenKitNewFileIconWidth}" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <others:FileIcon
                                        Grid.RowSpan="2"
                                        Grid.Column="0"
                                        Width="{DynamicResource WolvenKitIconTiny}"
                                        Icon="{Binding Extension}" />

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="{DynamicResource WolvenKitMarginTinyLeft}"
                                        FontWeight="Bold"
                                        Text="{Binding Name}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="{DynamicResource WolvenKitMarginTinyLeft}"
                                        Text="{Binding Description}" />
                                </Grid>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>
        </DockPanel>

        <!-- BOTTOM NAME BAR -->
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="{DynamicResource WolvenKitMarginSmallVertical}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Margin="{DynamicResource WolvenKitMarginSmallRight}"
                    VerticalAlignment="Center"
                    Text="Name:" />

                <hc:TextBox
                    x:Name="FileName"
                    Grid.Column="1"
                    Margin="{DynamicResource WolvenKitMarginSmallRight}"
                    FlowDirection="LeftToRight" />

                <controls:RedTypeTemplateDropdown
                    Grid.Column="2"
                    ViewModel="{Binding RedTypeTemplateDropdownViewModel}"/>
            </Grid>
        </Border>

        <Grid
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="1"
                Margin="{DynamicResource WolvenKitMarginSmallRight}"
                VerticalAlignment="Center"
                Foreground="{DynamicResource WolvenKitRed}"
                Text="{Binding WhyNotCreate}" />

            <Button
                x:Name="OkButton"
                Grid.Column="2"
                Padding="{DynamicResource WolvenKitMarginSmall}"
                HorizontalAlignment="Right"
                Background="{DynamicResource WolvenKitRed}"
                Content="Create" />

            <Button
                x:Name="CancelButton"
                Grid.Column="3"
                Margin="{DynamicResource WolvenKitMarginSmallLeft}"
                Padding="{DynamicResource WolvenKitMarginSmall}"
                HorizontalAlignment="Right"
                Content="Cancel" />
        </Grid>
    </Grid>
</reactiveUi:ReactiveUserControl>
